# GitHub token with repo + pull_request scope (or GitHub App installation token via fabric-ctrl)
GITHUB_TOKEN=

# Repos to monitor (comma-separated owner/repo)
MANAGED_REPOS=git-fabric/fabric-ctrl,git-fabric/cve

# State repo for persisting review history (owner/repo)
STATE_REPO=git-fabric/fabric-state

# Optional: eagle-scout endpoint for container CVE scanning
EAGLE_SCOUT_ENDPOINT=
